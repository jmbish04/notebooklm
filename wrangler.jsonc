{
  "name": "notebooklm",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-03-09",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "ce88d38e94fb4642a935bbae9c1f355c",
    },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notebooklm",
      "database_id": "822b7f26-8045-4627-8a7f-4fe88e529660",
      "preview_database_id": "822b7f26-8045-4627-8a7f-4fe88e529660",
      "migrations_dir": "drizzle",
    },
  ],
  // Only the credential this Worker actually uses. The template shipped a dozen
  // more, several pointing at secrets that do not exist in the store — those
  // fail the deploy, and an unused binding is a credential handed out for free.
  "secrets_store_secrets": [
    {
      "binding": "WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "WORKER_API_KEY",
    },
  ],
}
